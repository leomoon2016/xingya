# 依赖与构建产物
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# 本地生成的音频与临时文件（服务器上 Piper 输出在 /var/lib/xingya/tmp，不进仓库）
*.wav
tmp/
# 本地 OSS 模拟目录（集成测试与 e2e）
.oss-local/

# 测试产物
apps/web/test-results/
apps/web/playwright-report/

# 环境变量与机密（服务器上放 /etc/xingya/secrets.env，绝不进仓库）
.env
.env.*
!.env.example
secrets.env
*.pem
*.key

# 数据库导出与备份（绝不提交数据）
*.sql.gz
*.sqlite
*.dump

# 系统与编辑器
.DS_Store
.idea/
.vscode/
*.log
